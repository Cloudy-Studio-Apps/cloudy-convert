{
  "name": "cloudy-convert",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:linux": "NO_STRIP=true tauri build --bundles deb,rpm,appimage",
    "release:arch": "tauri build --no-bundle && cd packaging/arch && makepkg -f --nodeps",
    "release:tag": "node scripts/release-tag.mjs",
    "release:win": "node scripts/fetch-ffmpeg-win.mjs && tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
